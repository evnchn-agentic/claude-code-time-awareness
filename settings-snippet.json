{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__playwright__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/time-stamp.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/time-stamp.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
